# ============================================
# FASHION STORE - Environment Variables
# ============================================

# ============================================
# DATABASE (Supabase PostgreSQL)
# ============================================
# Получите из: Supabase Dashboard → Settings → Database
DATABASE_URL="postgresql://postgres.xxx:password@xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# ============================================
# SUPABASE
# ============================================
# Получите из: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ============================================
# AUTHENTICATION (NextAuth)
# ============================================
# Сгенерируйте: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Дополнительный JWT секрет
JWT_SECRET="your-jwt-secret-key"

# ============================================
# ENCRYPTION (для паспортных данных)
# ============================================
# Сгенерируйте: openssl rand -hex 32
# ВАЖНО: Сохраните этот ключ! Без него данные не расшифровать!
ENCRYPTION_KEY="your-32-byte-encryption-key-here"

# ============================================
# UPSTASH REDIS (КРИТИЧНО для production!)
# ============================================
# Получите из: https://console.upstash.com/
# Используется для: rate limiting, кэш, чат
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# ============================================
# OPENAI (для AI-чата поддержки)
# ============================================
# Получите из: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ============================================
# STRIPE (платежи картами)
# ============================================
# Получите из: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# EMAIL (Yandex SMTP или Resend)
# ============================================
# Для Yandex: smtp.yandex.ru, порт 465, SMTP_SECURE=true
# Для Gmail: smtp.gmail.com, порт 587, SMTP_SECURE=false
# Если не указано — используется Resend (RESEND_API_KEY)
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@yandex.ru"
SMTP_PASSWORD="your-app-password-16-chars"
EMAIL_FROM="Fashion Store <your-email@yandex.ru>"

# Альтернатива: Resend API (https://resend.com)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Fashion Store <noreply@yourdomain.com>"

# ============================================
# TELEGRAM (уведомления)
# ============================================
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Telegram-вход (Login Widget). Необязательно: bot_id выводится из TELEGRAM_BOT_TOKEN
# в рантайме через /api/auth/telegram-config. Задайте для явного override.
# NEXT_PUBLIC_TELEGRAM_BOT_ID="123456789"
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="YourBot"
# ВАЖНО: в @BotFather выполните /setdomain и укажите домен страницы входа
# (напр. e1evate.vercel.app), иначе попап покажет «Bot domain invalid».

# ============================================
# ANALYTICS (опционально)
# ============================================
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ============================================
# DEVELOPMENT
# ============================================
# Установите в 'development' для локальной разработки
NODE_ENV="development"
